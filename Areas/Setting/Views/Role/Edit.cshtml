@model BackOffice.Areas.Setting.Models.Role
@using System.Text.Json;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Role</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="POST" onsubmit="SaveForm()">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="role_id" />
            <div class="my-3">
                <label asp-for="role_name" class="form-label"></label>
                <input asp-for="role_name" class="form-control" maxlength="10"/>
                <span asp-validation-for="role_name" class="text-danger"></span>
            </div>
            <div class="my-3">
                <label asp-for="description" class="form-label"></label>
                <input asp-for="description" class="form-control" maxlength="100"/>
                <span asp-validation-for="description" class="text-danger"></span>
            </div>

            <div class="my-3">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
<script>
   let s = @(JsonSerializer.Serialize(TempData["Success"]));
        let m = @Html.Raw(JsonSerializer.Serialize(TempData["Message"]));
        let InputRoleName = document.getElementById("role_name");
        let InputDescription = document.getElementById("description");
        function SaveForm() {
            sessionStorage.setItem("role_name", InputRoleName.value);
            sessionStorage.setItem("description", InputDescription.value);
        }
        if (m) {
            InputRoleName.value = sessionStorage.getItem("role_name");
            InputDescription.value = sessionStorage.getItem("description");
            alert(m);
            if (s) {
                sessionStorage.removeItem("role_name");
                sessionStorage.removeItem("description");
                window.location.href = '@Url.Action("index")';
            }
        }
</script>
}