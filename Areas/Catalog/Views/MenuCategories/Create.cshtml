@model BackOffice.Areas.Catalog.Models.MenuCategories
@using System.Text.Json
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    ViewData["Title"] = "新增餐點分類";
}
<h4>新增餐點分類</h4>
<hr />
<form method="post" class="form" asp-action="Create" onsubmit="SaveForm(event)">
    <div class=col-md-4>
        <div class="my-3">
            <label asp-for="category_name" class="form-label">分類名稱<span style="color:red;">*</span></label>
            <input asp-for="category_name" type="text" class="form-control" maxlength="50" required/>
        </div>
        <div class="my-3">
            <label asp-for="sort" class="form-label">排序<span style="color:red;">*</span></label>
            <input asp-for="sort" type="number" class="form-control" min="0" max="999" required/>
        </div>
        <div class="my-3">
            <input type="submit" class="btn btn-primary" value="新增"/>
        </div>
    </div>

</form>
<div>
    <a asp-action="Index">返回上一頁</a>
</div>

@section Scripts{
    <script>
        let s = @(JsonSerializer.Serialize(TempData["Success"]));
        let m = @Html.Raw(JsonSerializer.Serialize(TempData["Message"]));
        let InputCategoryName = $("#category_name");
        let InputSort = $("#sort");
        function SaveForm(){
            sessionStorage.setItem("category_name",InputCategoryName.val());
            sessionStorage.setItem("sort",InputSort.val());
        }
        if (m){
            InputCategoryName.val(sessionStorage.getItem("category_name"));
            InputSort.val(sessionStorage.getItem("sort"));
            alert (m);
            if (s){
                sessionStorage.removeItem("category_name");
                sessionStorage.removeItem("sort");
                window.location.href='@Url.Action("Index")';
            }
        }

    </script>

}