@model BackOffice.Areas.Setting.Models.User
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-hant-TW">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
      
    <title>登入</title>
</head>

<body>
    <div class="container">
        <h1>後台登入</h1>
        <form asp-controller="Account" asp-action="Login" method="post">
            <div>
                <div>
                    <label asp-for="user_name" class="form-label">帳號</label>
                    <input type="text" asp-for="user_name" class="form-control" placeholder="請輸入帳號" />
                </div>
                <div>
                    <label asp-for="password_hash" class="form-label">密碼</label>
                    <input type="text" asp-for="password_hash" class="form-control" placeholder="請輸入密碼" />
                </div>
                <button type="submit" class="btn btn-warning">登入</button>
            </div>
        </form>
    </div>
</body>

</html>